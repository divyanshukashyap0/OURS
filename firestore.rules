rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Public read access for products (shop)
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public read for projects and blogs
    match /projects/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /blogs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses: Public read, Admin write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course Progress: Authenticated User read/write their own
    // ID format is usually uid_courseId, allowing us to validate ownership by ID 
    // OR by checking the userId field in the document.
    match /course_progress/{progressId} {
        allow read, write: if request.auth != null && (
            progressId.matches(request.auth.uid + '_.*') || 
            resource.data.userId == request.auth.uid ||
            request.resource.data.userId == request.auth.uid
        );
    }

    // Certificates: Public read for verification, Authenticated User create
    match /certificates/{certId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Immutable once created
    }

    // Orders: Create by anyone (including guests), Read by Admin/Owner
    match /orders/{document=**} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }
    
    // Site Settings: Public read, Admin write
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: Public read (for checkout), Admin write
    match /coupons/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Email Templates: Public read (for client-side sending), Admin write
    match /email_templates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subscribers: Public create, Admin read
    match /subscribers/{document=**} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Project Requests: Public create, Admin read
    match /project_requests/{document=**} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Student Requests: Authenticated users create, Admin full access
    match /student_requests/{document=**} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}